# Copy to api_secrets.env next to app.py, chmod 600, and never commit it.
#
# This repo does NOT embed archive credentials. The service needs DICOM on local
# disk; how it gets there is your choice.

# Bearer token for the prod archive (dcm.5cnetwork.com). Only prod needs auth;
# staging, qa and sandbox are open. The token is read from here and NEVER from a request.
NCCTF_DICOM_TOKEN=

# Optional override: a script taking <study_iuid> <env> <dest_dir>, exit non-zero on
# failure. Leave unset to use the built-in downloader (cysts/common/download_dicoms.py),
# which knows all four environments.
# CYSTS_DOWNLOAD_CMD=/opt/kidney-cysts/deploy/fetch_study.sh

# A 450 MB study at the measured ~150 KB/s per connection needs ~50 min; this is a cap.
CYSTS_DOWNLOAD_TIMEOUT=5400

# Service
CYSTS_API_HOST=0.0.0.0
CYSTS_API_PORT=8089
# Analyses are serialised regardless; this only sets how many wait in flight.
# Size from VRAM: roughly 7 GB per concurrent study while segmenting.
CYSTS_API_WORKERS=1

# Model location and identity. The defaults match the trained tree.
CYSTS_MODEL_DIR=/opt/kidney-cysts/model/nnUNet_results
CYSTS_DATASET=Dataset795_kidney_cropped
CYSTS_TRAINER=nnUNetTrainerFinetune1e3_500ep
CYSTS_CHECKPOINT=checkpoint_final.pth

# TotalSegmentator weights (~3 GB). Pre-populate so the first study does not stall.
TOTALSEG_HOME_DIR=/opt/kidney-cysts/.totalsegmentator
